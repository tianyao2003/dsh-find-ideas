  "cards": [
    {
      "dot": "cyan",
      "title": "工具面（4 个）",
      "items": [
        "apply(ctx) 注册 scout_projects / rank_candidates / inspect_projects / read_repo_files",
        "scout_projects：想法 → 查询规划 → 合并搜索，25s 超时",
        "rank_candidates：纯函数——代码算分排序 + 四类可疑检测，5s 超时",
        "inspect_projects：README / tree / 逐文件摘录 / 声明骨架，并行 3 个仓库，60s 超时",
        "read_repo_files：同一提交上点读 ≤4 个文件的行窗口，30s 超时"
      ]
    },
    {
      "dot": "emerald",
      "title": "共享底座",
      "items": [
        "四个工具都经 credentials.ts 取 GITHUB_TOKEN、经 cache.ts 复用结果",
        "四个工具都经 github.ts 取数、经 render.ts 出卡；图中只画主路径，避免同一条边画四遍",
        "cache.ts 两层：内存 5min（≤64 条）、磁盘 24h；源码读取单独 10min",
        "query.ts 规划 ≤3 条查询、≤6 个词；lexicon.ts 97 条中英词表",
        "pool.ts：有界并发映射，inspect 一次并行 3 个仓库，结果仍按调用方顺序"
      ]
    },
    {
      "dot": "violet",
      "title": "固定字节上限（v0.4.0）",
      "items": [
        "卡片上限固定 24,000 字节：没有 budget 参数，调用方调不了",
        "裁剪按「最便宜的损失优先」：依赖清单 → README → 逐文件摘录 → 声明骨架",
        "裁剪后附一行说明，写清扣掉了什么、以及怎么拿回来",
        "两条恢复路径：用 read_repo_files 点读那个文件，或下次少发几个仓库"
      ]
    },
    {
      "dot": "amber",
      "title": "诚实性保证",
      "items": [
        "输出分【代码计算区】/【调用方说明区】，并标注三类来源",
        "「未测量」不渲染成「测得 0」；失败是值 {reason, detail} 而非异常",
        "配额不足时前置熔断：requests_used: 0，一次请求都不发",
        "第三方文本用防伪围栏；链接仅允许 github.com 与 raw.githubusercontent.com"
      ]
    }
  ]
}
