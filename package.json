{
  "name": "dsh-find-ideas",
  "description": "Search GitHub for open-source projects similar to a user's idea, rank them, and extract class/function signature skeletons from selected projects.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "tianyao2003",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianyao2003/dsh-find-ideas.git"
  },
  "homepage": "https://github.com/tianyao2003/dsh-find-ideas#readme",
  "bugs": {
    "url": "https://github.com/tianyao2003/dsh-find-ideas/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "prior-art",
    "architecture",
    "code-search"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node test/run-all.test.mjs",
    "test:runner": "node --test \"test/**/*.test.mjs\"",
    "check:peers": "node scripts/check-peers.mjs",
    "readme:sample": "node scripts/readme-sample.mjs",
    "readme:check": "node scripts/readme-sample.mjs --check",
    "check": "npm run typecheck && npm run build && npm run readme:check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.2 || ^0.1.3-alpha.2 || ^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "test",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/dsh-find-ideas-architecture.png"
  ],
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "22.20.4",
    "semver": "7.8.5",
    "typescript": "5.9.3"
  }
}
